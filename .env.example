# Values to fill in after importing the workflows into n8n.
# n8n doesn't read this file directly: paste each value into the matching node or credential.

# Email (SMTP credential in n8n + "from"/"to" fields on the email nodes)
REPORT_FROM_EMAIL=reports-sender@example.com
REPORT_TO_EMAIL=reports-recipient@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# WhatsApp via WAHA (replace YOUR_WAHA_API_KEY in the WhatsApp Report Bot)
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default

# ClickUp (ClickUp credential in n8n)
CLICKUP_API_KEY=
CLICKUP_TEAM_ID=

# Groq Whisper for voice notes (Management Tracker Chatbot, optional)
GROQ_API_KEY=

# Folders used by the workflows (replace C:\automation\... in the nodes if yours differ)
AUTOMATION_ROOT=C:\automation
INCOMING_DATA_DIR=C:\automation\incoming
REPORTS_DIR=C:\automation\daily\reports
