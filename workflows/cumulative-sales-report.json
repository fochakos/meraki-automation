    {
      "parameters": {
        "jsCode": "const { execFileSync } = require('child_process');\nconst nodeProcess = require('process');\n\nconst PYTHON = \"python\";\nconst SCRIPT = \"C:\\\\automation\\\\daily\\\\scripts\\\\resolve_api.py\";\n\nlet state;\ntry {\n  const out = execFileSync(PYTHON, [SCRIPT, 'get_state'], { encoding: 'utf-8', env: nodeProcess.env });\n  state = JSON.parse(out);\n} catch (e) {\n  state = { missing_names: [], missing_managers: [], error: e.message };\n}\n\nconst missingNamesCount = (state.missing_names || []).length;\nconst missingManagersCount = (state.missing_managers || []).length;\nconst total = missingNamesCount + missingManagersCount;\n\nreturn [{\n  json: {\n    missingNamesCount,\n    missingManagersCount,\n    total,\n    resolverUrl: 'http://localhost:5678/webhook/resolve-names',\n  }\n}];"
      },
