    {
      "parameters": {
        "jsCode": "const cp = require('child_process');\nconst nodeProcess = require('process');\nconst scriptPath = 'C:\\\\automation\\\\run_cumulative.py';\nconst childEnv = Object.assign({}, nodeProcess.env);\nchildEnv.APPDATA = childEnv.APPDATA || 'C:\\\\Users\\\\<USER>\\\\AppData\\\\Roaming';\nchildEnv.USERPROFILE = childEnv.USERPROFILE || 'C:\\\\Users\\\\<USER>';\nchildEnv.LOCALAPPDATA = childEnv.LOCALAPPDATA || 'C:\\\\Users\\\\<USER>\\\\AppData\\\\Local';\nlet output = '';\nlet success = true;\ntry {\noutput = cp.execFileSync('python', [scriptPath], { encoding: 'utf-8', env: childEnv });\n} catch (err) {\nsuccess = false;\noutput = String(err.stdout || '') + '\\n' + String(err.stderr || err.message || err);\n}\nreturn [{ json: { success: success, output: output } }];"
