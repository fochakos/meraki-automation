        "jsCode": "const { execFileSync } = require('child_process'); const REP = 'C:\\\\automation\\\\daily\\\\reports'; let output = ''; let filePath = ''; let success = true; try { output = execFileSync('cmd.exe', ['/c', 'dir', '/b', '/o-d', REP], { encoding: 'utf-8' }); const files = output.split(/\\r?\\n/).map(s => s.trim()).filter(s => s.toLowerCase().endsWith('.xlsx')); if (files.length === 0) { success = false; } else { filePath = REP + '\\\\' + files[0]; } } catch (err) { success = false; output = String(err.stdout || '') + '\\n' + String(err.stderr || err.message || err); } return [{ json: { success: success, filePath: filePath, output: output } }];"
      },
