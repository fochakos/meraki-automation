    {
      "parameters": {
        "jsCode": "const { execFileSync } = require('child_process');\n\nconst filePath = $('Parse & Decide').item.json.filePath;\nconst fileName = filePath.split('\\\\').pop().split('/').pop();\nconst mimetype = 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';\n\nconst psCmd = \"[Convert]::ToBase64String([IO.File]::ReadAllBytes('\" + filePath.replace(/'/g, \"''\") + \"'))\";\nconst data = execFileSync('powershell.exe', ['-NoProfile', '-Command', psCmd], { maxBuffer: 1024 * 1024 * 100 }).toString('utf8').trim();\n\nreturn [{\n  json: {\n    session: 'default',\n    chatId: $('Parse & Decide').item.json.chatId,\n    file: {\n      mimetype,\n      filename: fileName,\n      data,\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
