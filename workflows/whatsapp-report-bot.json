    {
      "parameters": {
        "jsCode": "const { execFileSync } = require('child_process');\n\nconst CONTACTS_FILE = \"C:\\\\automation\\\\config\\\\whatsapp_contacts.json\";\nconst REPORTS_DIR = \"C:\\\\automation\\\\daily\\\\reports\";\nconst WAHA_BASE = \"http://localhost:3000\";\nconst WAHA_API_KEY = \"YOUR_WAHA_API_KEY\";\nconst WAHA_SESSION = \"default\";\n\nconst item = $input.first().json;\nconst body = item.body || item;\nconst payload = body.payload || body;\nconst fromMe = payload.fromMe === true;\nconst rawFrom = String(payload.from || payload.chatId || '');\nconst text = String(payload.body || payload.text || '').trim();\n\nlet phone = rawFrom.replace(/@.*/, '').replace(/\\D/g, '');\n\n// WhatsApp often reports the sender as an internal @lid instead of a phone-number JID.\n// Resolve it back to the real phone number via WAHA's lid lookup when that happens.\nif (/@lid$/i.test(rawFrom)) {\n  try {\n    const url = WAHA_BASE + '/api/' + WAHA_SESSION + '/lids/' + encodeURIComponent(rawFrom);\n    const raw = execFileSync('curl.exe', ['-s', '-H', 'X-Api-Key: ' + WAHA_API_KEY, url], { encoding: 'utf-8' });\n    const data = JSON.parse(raw);\n    if (data && data.pn) {\n      phone = String(data.pn).replace(/@.*/, '').replace(/\\D/g, '');\n    }\n  } catch (e) {\n    // leave phone as the lid digits if resolution fails\n  }\n}\n\nlet outcome = 'ignore';\nlet email = '';\nlet filePath = '';\n\nif (!fromMe && String(body.event || '').toLowerCase() === 'message' && /cumulative\\s*report/i.test(text)) {\n  let contacts = {};\n  try {    const raw = execFileSync('cmd.exe', ['/c', 'type', CONTACTS_FILE], { encoding: 'utf-8' });\n    contacts = JSON.parse(raw);\n  } catch (e) {\n    contacts = {};\n  }\n  const entry = contacts[phone];\n  if (entry && entry.email) {\n    email = entry.email;\n    try {\n      const out = execFileSync('cmd.exe', ['/c', 'dir', '/b', '/o-d', REPORTS_DIR], { encoding: 'utf-8' });\n      const files = out.split(/\\r?\\n/).map(s => s.trim()).filter(s => s.toLowerCase().endsWith('.xlsx'));\n      if (files.length) {\n        filePath = REPORTS_DIR + '\\\\' + files[0];\n        outcome = 'send_report';\n      } else {\n        outcome = 'no_report';\n      }\n    } catch (e) {\n      outcome = 'no_report';\n    }\n  } else {\n    outcome = 'not_registered';\n  }\n}\n\nreturn [{ json: { outcome, phone, email, filePath, text, chatId: rawFrom } }];"
      },
